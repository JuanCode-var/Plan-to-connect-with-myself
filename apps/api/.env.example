# Copiá este archivo a ".env" (sin ".example") en la misma carpeta y pegá
# tus valores reales ahí — ".env" está en .gitignore, nunca se sube al repo.
# Instrucciones completas (incluyendo cómo conseguir las variables de Turso
# de abajo) en apps/api/README.md, sección "Configurar una máquina nueva".

# API key de console.anthropic.com (Settings -> API Keys -> Create Key).
# Necesaria para la fase 3 del agente de insights (redacción con IA en
# apps/api/src/services/insights.ts). Sin esto, el resto de la app funciona
# igual — solo esa capa opcional queda inactiva.
ANTHROPIC_API_KEY=sk-ant-...

# Puerto donde escucha la API (default 5000 si no se define). Cambialo acá
# si en tu dispositivo ya está ocupado — recordá actualizar también
# API_PORT en apps/web/.env (o tu entorno) para que el proxy de Vite
# apunte al mismo puerto.
PORT=5000

# --- Base de datos (Turso / libSQL) ---
# La app en runtime SIEMPRE se conecta a Turso (ver apps/api/src/db.ts) para
# que los datos sean los mismos en cualquier máquina que clone el repo. Las
# dos variables de abajo se consiguen así (requiere cuenta en turso.tech):
#   turso db show <nombre-db> --url
#   turso db tokens create <nombre-db>
TURSO_DATABASE_URL=libsql://<nombre-db>-<usuario>.turso.io
TURSO_AUTH_TOKEN=

# Solo la usan los comandos de Prisma CLI (migrate/generate/studio), que
# todavía no soportan conectarse directo a Turso — ver README. Apunta a un
# sqlite local descartable, no es la base real de la app.
DATABASE_URL="file:../data/dev.db"
