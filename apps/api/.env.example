# Copiá este archivo a ".env" (sin ".example") en la misma carpeta y pegá
# tu key real ahí — ".env" está en .gitignore, nunca se sube al repo.

# API key de console.anthropic.com (Settings -> API Keys -> Create Key).
# Necesaria para la fase 3 del agente de insights (redacción con IA en
# apps/api/src/services/insights.ts). Sin esto, el resto de la app funciona
# igual — solo esa capa opcional queda inactiva.
ANTHROPIC_API_KEY=sk-ant-...

# Puerto donde escucha la API (default 5000 si no se define). Cambialo acá
# si en tu dispositivo ya está ocupado — recordá actualizar también
# API_PORT en apps/web/.env (o tu entorno) para que el proxy de Vite
# apunte al mismo puerto.
PORT=5000
