generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/dev.db"
}

// NOTA: el conector sqlite de Prisma no soporta el tipo `enum` nativo (limitación
// estructural y permanente de SQLite, no de la versión de Prisma instalada). Los
// campos que en design.md son enums se modelan aquí como `String` con el contrato
// de valores documentado en el comentario de cada campo. Ese contrato se valida en
// la capa de API con zod antes de persistir (secciones 3-6 de tasks.md) y es el
// mismo contrato que consume el frontend: cualquier cambio a estos valores requiere
// grep en apps/web/src y apps/api/src (ver reglas del guardian del schema).
//
// HabitCategory: FISICO | ECONOMICO | MENTAL | EMOCIONAL | HABILIDADES | ESPIRITUAL (área de vida)
// HabitPriority: ALTA | MEDIA | BAJA (urgencia, campo independiente de la categoría)
// HabitMoment:   MANANA | DIA | NOCHE | CIERRE_DEL_DIA
// LogStatus:     DONE | PENDING | NA
// GoalStatus:    PENDIENTE | EN_PROGRESO | CUMPLIDA

// User es intencionalmente independiente del resto del modelo (sin
// relaciones a Habit/Cycle/HabitLog/EmotionalEntry): esta sigue siendo una
// app de una sola persona por instancia, no multi-tenant. La cuenta existe
// para identificar "quién entra" y personalizar (nombre, saludo según hora,
// felicitaciones), no para particionar los hábitos/ciclos por usuario.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Habit {
  id            String     @id @default(cuid())
  name          String
  moment        String // HabitMoment: MANANA | DIA | NOCHE | CIERRE_DEL_DIA
  specification String
  category      String // HabitCategory: FISICO | ECONOMICO | MENTAL | EMOCIONAL | HABILIDADES | ESPIRITUAL
  priority      String // HabitPriority: ALTA | MEDIA | BAJA
  sortOrder     Int
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
  logs          HabitLog[]
}

model Cycle {
  id        String     @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime   @default(now())
  logs      HabitLog[]
  goals     Goal[]
}

model HabitLog {
  id      String   @id @default(cuid())
  habitId String
  habit   Habit    @relation(fields: [habitId], references: [id])
  cycleId String
  cycle   Cycle    @relation(fields: [cycleId], references: [id])
  date    DateTime
  status  String   @default("PENDING") // LogStatus: DONE | PENDING | NA

  @@unique([habitId, date])
  @@index([cycleId, date])
}

// LibrarySection: LIBRO | FRASE | FILOSOFIA
// LibrarySource:  SEED (curado por la app, no editable) | USER (agregado por
// la persona, se puede borrar)
model LibraryEntry {
  id        String   @id @default(cuid())
  section   String // LibrarySection: LIBRO | FRASE | FILOSOFIA
  source    String // LibrarySource: SEED | USER
  title     String?
  author    String?
  content   String
  createdAt DateTime @default(now())
  // Frase anclada en /tracker hasta esta fecha/hora (instante exacto, no
  // fecha pura como HabitLog.date: acá sí importa la hora porque "un día"
  // significa 24hs desde que se ancla, no hasta medianoche). Solo una
  // entrada puede estar anclada a la vez: al anclar una nueva se limpia el
  // pinnedUntil de cualquier otra (ver POST /library/:id/pin).
  pinnedUntil DateTime?

  @@index([section])
}

model EmotionalEntry {
  id        String   @id @default(cuid())
  date      DateTime
  // Opcional a propósito: una entrada puede ser un check-in emocional (con
  // emoción) o una entrada de solo "Conocimientos y reflexiones" sin pasar
  // por ninguna situación emocional puntual.
  emotion   String?
  situation String?
  feeling   String?
  impulse   String?
  decision  String?
  learning  String?
  // Distinto de `learning`: ese es lo aprendido DE ESTA situación puntual;
  // `knowledge` es un espacio más general para conocimientos/ideas del día
  // que no dependen de haber pasado por una situación emocional difícil.
  knowledge String?
  // Tercera sección independiente del Diario (ver comentario de `knowledge`
  // arriba, mismo criterio): lo que la persona agradece ese día, sin
  // depender de un check-in emocional ni de una reflexión.
  gratitude String?
  createdAt DateTime @default(now())

  @@index([date])
}

// Metas del ciclo activo. Modelo basado en la técnica de coaching de 5 fases
// (ver Técnica de visualización y establecimiento de metas.txt) fusionada con
// los 3 pasos de Brian Tracy para lograr metas (decidir con claridad, escribir
// con fecha límite, listar y accionar los pasos todos los días):
//   Fase 1 (exploración)      -> why
//   Fase 2 (visualización)    -> visualization
//   Fase 3 (meta SMART)       -> specification + targetDate
//   Fase 4 (plan de acción)   -> GoalStep[] (Tracy paso 3: la lista de todo
//                                 lo necesario, accionable día a día)
//   Fase 5 (seguimiento/eval) -> status + followUpNotes + celebration
model Goal {
  id            String     @id @default(cuid())
  cycleId       String
  cycle         Cycle      @relation(fields: [cycleId], references: [id])
  title         String
  why           String?
  visualization String?
  specification String
  targetDate    DateTime
  status        String     @default("PENDIENTE") // GoalStatus: PENDIENTE | EN_PROGRESO | CUMPLIDA
  followUpNotes String?
  // Solo tiene sentido completo una vez que `status` = CUMPLIDA, pero no se
  // fuerza a nivel de schema (la persona puede ir anotando ideas de cómo
  // celebrar antes de llegar a la meta).
  celebration   String?
  sortOrder     Int
  createdAt     DateTime   @default(now())
  steps         GoalStep[]

  @@index([cycleId])
}

model GoalStep {
  id          String   @id @default(cuid())
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id])
  description String
  done        Boolean  @default(false)
  sortOrder   Int
  createdAt   DateTime @default(now())

  @@index([goalId])
}
